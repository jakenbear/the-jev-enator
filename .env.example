# Copy to .env and add your key, then run ./install.sh
#
# install.sh reads the key from here and copies it into ~/.claude/settings.json,
# which is where the hook process can actually see it. This file is only used for
# install and for running the test suites directly.
#
# Never commit .env — it is gitignored.

export TYPESAFE_API_KEY=""

# Audit log: one JSONL line per classification with scores, latency, and tokens.
# Keep this identical to the JEV_LOG that install.sh writes into settings.json,
# or tests and real sessions will log to different files and report.sh will only
# see one of them.
#
# This said JEV_GATE_LOG until the rename, which quietly broke every new install:
# the old name still works, so a fresh clone that copied this file was already
# "using a pre-rename name" -- install.sh saw JEV_GATE_LOG set and skipped
# writing JEV_LOG (deliberately, to avoid two names for one setting), and
# verify.sh then nagged about a deprecated name the person had never chosen.
export JEV_LOG="$HOME/jev-enator.jsonl"

# Set to 1 to bypass every hook in this repo for this shell.
# export JEV_DISABLE=1
